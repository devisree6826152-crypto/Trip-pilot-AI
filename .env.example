# TripPilot AI Environment Configuration

# Geoapify API Key for Geocoding, Places & Routing
GEOAPIFY_API_KEY=

# Data storage mode: local | supabase (default: local)
NEXT_PUBLIC_DATA_MODE=local

# Anthropic / OpenAI API key (Optional: fallback engine used if omitted)
ANTHROPIC_API_KEY=

# Supabase configuration (Optional: for production migration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
